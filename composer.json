{
    "name": "arnoldswaeger/ci4-dashboard-system",
    "description": "CodeIgniter 4 Dashboard System with MVC, CRUD Users, and Shield Authentication",
    "license": "MIT",
    "require": {
        "php": "^7.4 || ^8.0",
        "codeigniter4/framework": "^4.4",
        "codeigniter4/shield": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "serve": "php spark serve"
    }
}
